# Copy to config.env and edit. config.env is git-ignored.

# Working area for everything heavy: cloned repos, venvs, TensorRT, clips, outputs, logs.
SONIC_WORK=/path/to/work

# GPU used for TensorRT inference and the SOMA->SMPL conversion.
GPU_ID=0

# Interactive sim stack (virtual display + VNC + tmux). Change if these collide with something else.
TMUX_SESSION=vnc
DISPLAY_NUM=77
VNC_PORT=5977
NOVNC_PORT=6088
ZMQ_POSE_PORT=5556
ZMQ_DEBUG_PORT=5557

# HF token file (KEY=VALUE lines, needs HF_TOKEN). Lives outside the repo.
# ENV_FILE=$SONIC_WORK/.env

# Optional tool locations. Leave unset to use whatever is on PATH.
# Only needed when you installed things without root (see docs/SETUP.md).
# TENSORRT_ROOT=$SONIC_WORK/TensorRT
# DEPS_PREFIX=$SONIC_WORK/tools/prefix        # user-level msgpack / nlohmann-json / onnxruntime
# CLANG_DIR=$SONIC_WORK/tools/clangbin        # a dir containing clang (deploy.sh insists on it)
# XVFB_BIN=/usr/bin/Xvfb
# X11VNC_BIN=/usr/bin/x11vnc
# WEBSOCKIFY_BIN=/usr/bin/websockify
# NOVNC_DIR=/usr/share/novnc
# VNC_LD_LIBRARY_PATH=                         # extra libs for a user-level x11vnc
